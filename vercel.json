{
  "crons": [
    {
      "path": "/api/cron-macro-watch",
      "schedule": "0 1 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/binance/:path*",
      "destination": "https://data-api.binance.vision/api/v3/:path*"
    },
    {
      "source": "/api/fapi/:path*",
      "destination": "https://fapi.binance.com/:path*"
    },
    {
      "source": "/api/yahoo/:path*",
      "destination": "https://query1.finance.yahoo.com/:path*"
    },
    {
      "source": "/api/entrade/:path*",
      "destination": "https://services.entrade.com.vn/:path*"
    },
    {
      "source": "/api/vndirect/:path*",
      "destination": "https://api-finfo.vndirect.com.vn/:path*"
    },
    {
      "source": "/api/simplize/:path*",
      "destination": "https://api2.simplize.vn/:path*"
    },
    {
      "source": "/api/fred/:path*",
      "destination": "https://fred.stlouisfed.org/:path*"
    },
    {
      "source": "/api/deribit/:path*",
      "destination": "https://www.deribit.com/:path*"
    },
    {
      "source": "/api/cboe/:path*",
      "destination": "https://cdn.cboe.com/:path*"
    },
    {
      "source": "/api/coingecko/:path*",
      "destination": "https://api.coingecko.com/:path*"
    },
    {
      "source": "/api/llama/:path*",
      "destination": "https://stablecoins.llama.fi/:path*"
    },
    {
      "source": "/api/nasdaq/:path*",
      "destination": "https://api.nasdaq.com/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
