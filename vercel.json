{
  "headers": [
    {
      "source": "/api/(binance|fapi|yahoo|entrade)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/binance/:path*",
      "destination": "https://data-api.binance.vision/api/v3/:path*"
    },
    {
      "source": "/api/fapi/:path*",
      "destination": "https://fapi.binance.com/:path*"
    },
    {
      "source": "/api/yahoo/:path*",
      "destination": "https://query1.finance.yahoo.com/:path*"
    },
    {
      "source": "/api/entrade/:path*",
      "destination": "https://services.entrade.com.vn/:path*"
    },
    {
      "source": "/api/fred/:path*",
      "destination": "https://fred.stlouisfed.org/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
